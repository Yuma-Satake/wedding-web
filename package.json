{
  "name": "wedding-web",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "prepare": "lefthook install",
    "og": "sh scripts/generate-og.sh",
    "worker:dev": "wrangler dev --config workers/lt-remote/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config workers/lt-remote/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.4",
    "astro": "^7.3.4",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "tailwindcss": "4.3.3",
    "vitest": "5.0.1",
    "wrangler": "4.157.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.6.0",
  "allowScripts": {
    "esbuild": true
  }
}
