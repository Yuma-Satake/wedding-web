---
import { SURVEY_URL } from "../consts";
---

<a
  href={SURVEY_URL}
  target="_blank"
  rel="noopener"
  class="group mx-auto mt-6 block max-w-64 border border-dashed border-deep-red/50 bg-white/50 px-5 pt-4 pb-3.5 text-center text-deep-red transition-colors hover:border-deep-red hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-deep-red"
>
  <span class="block font-script text-[1.75rem] leading-none" lang="en">Questionnaire</span>
  <span class="mt-2 block text-sm leading-relaxed tracking-wider">
    アンケートへのご回答が<br />まだの方はこちら<span
      class="ml-1.5 inline-block transition-transform group-hover:translate-x-1"
      aria-hidden="true">→</span
    >
  </span>
</a>
