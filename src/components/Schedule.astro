---
import SectionTitle from "./SectionTitle.astro";

const items = [
  { time: "10:30", label: "受付開始", icon: "letter" },
  { time: "11:00", label: "挙式", icon: "rings" },
  { time: "12:00", label: "披露宴", icon: "toast" },
  { time: "14:45", note: "頃", label: "お開き", icon: "heart" },
];
---

<section
  class="scallop-top scallop-bottom bg-blush-soft px-6 py-16"
>
  <SectionTitle en="Schedule" ja="当日のご案内" />

  <div class="mx-auto mt-10 max-w-[20rem] border border-deep-red/40 bg-ivory p-1.5">
    <div class="border border-deep-red/25 px-5 pt-8 pb-7">
      <p class="text-center font-roman text-sm tracking-[0.3em] text-rose-taupe italic" lang="en">
        Program
      </p>
      <ol class="mt-5">
        {
          items.map((item) => (
            <li class="flex items-center gap-3 py-3">
              <svg
                class="h-6 w-6 flex-none text-deep-red"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {item.icon === "letter" && (
                  <>
                    <rect x="3" y="6" width="18" height="13" rx="1.5" />
                    <path d="M3.5 7l8.5 6.5L20.5 7" />
                  </>
                )}
                {item.icon === "rings" && (
                  <>
                    <circle cx="9" cy="14.5" r="5" />
                    <circle cx="15" cy="14.5" r="5" />
                    <path d="M7.4 7.6L9 5.5l1.6 2.1L9 9.2z" />
                  </>
                )}
                {item.icon === "toast" && (
                  <>
                    <path d="M4.5 4.5l4.6 1.2-1 4.1a2.4 2.4 0 0 1-4.6-1.2z" />
                    <path d="M6 11.2l-1.3 5.2M3 16l3.4.9" />
                    <path d="M19.5 4.5l-4.6 1.2 1 4.1a2.4 2.4 0 0 0 4.6-1.2z" />
                    <path d="M18 11.2l1.3 5.2M21 16l-3.4.9" />
                    <path d="M12 2.5v2M9.8 3.2l.8 1.2M14.2 3.2l-.8 1.2" />
                  </>
                )}
                {item.icon === "heart" && (
                  <path d="M12 20c-6.5-4.4-8.6-8.4-6.6-11.2 1.6-2.2 4.8-2 6.6.6 1.8-2.6 5-2.8 6.6-.6 2 2.8-.1 6.8-6.6 11.2z" />
                )}
              </svg>
              <span class="w-[4.75rem] flex-none font-roman text-[1.75rem] leading-none font-medium text-deep-red lining-nums">
                {item.time}
                {item.note && (
                  <span class="ml-0.5 font-mincho text-xs text-rose-taupe">{item.note}</span>
                )}
              </span>
              <span
                class="h-px min-w-3 flex-1 border-b border-dotted border-deep-red/50"
                aria-hidden="true"
              />
              <span class="text-base tracking-[0.2em] text-ink">{item.label}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
