---
import Bouquet from "./Bouquet.astro";
---

<footer class="px-6 pt-20 pb-16 text-center">
  <p class="font-script text-5xl text-deep-red" lang="en">Thank you</p>
  <p class="mt-5 text-sm leading-loose tracking-wider text-ink">
    皆様にお会いできるのを<br />心より楽しみにしております
  </p>
  <Bouquet class="mx-auto mt-8 w-28" />
  <p class="mt-6 text-base font-medium tracking-[0.2em] text-ink">
    佐竹 友真<span class="mx-2 text-deep-red">・</span>阿部 愛望
  </p>
  <p class="mt-2 font-roman lining-nums text-sm tracking-[0.2em] text-rose-taupe">2026.11.07</p>
</footer>
