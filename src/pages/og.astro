---
import { Font } from "astro:assets";
import Bouquet from "../components/Bouquet.astro";
import "../styles/global.css";

const petals = [
  { x: 40, y: 30, r: 20, c: "#F4C2C2" },
  { x: 1150, y: 90, r: -30, c: "#C41E3A" },
  { x: 1160, y: 500, r: 50, c: "#F4C2C2" },
  { x: 70, y: 585, r: -60, c: "#C41E3A" },
  { x: 600, y: 18, r: 80, c: "#F4C2C2" },
  { x: 420, y: 592, r: 10, c: "#F4C2C2" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <Font cssVariable="--font-shippori" />
    <Font cssVariable="--font-cormorant" />
    <Font cssVariable="--font-pinyon" />
    <title>OGP</title>
    <style is:global>
      html,
      body {
        margin: 0;
        width: 1200px;
        height: 630px;
        overflow: hidden;
      }
      astro-dev-toolbar {
        display: none !important;
      }
    </style>
  </head>
  <body class="font-mincho text-ink antialiased">
    <div class="relative h-[630px] w-[1200px] overflow-hidden">
      <div class="absolute inset-x-14 inset-y-11 bg-ivory p-3 shadow-[0_4px_28px_rgba(139,75,75,0.14)]">
        <div class="h-full border border-deep-red/40 p-2">
          <div class="h-full border border-deep-red/25"></div>
        </div>
      </div>

      {
        petals.map((p) => (
          <span
            class="absolute h-[18px] w-[22px] rounded-[100%_0_100%_0/80%_0_100%_20%] opacity-80"
            style={`left:${p.x}px;top:${p.y}px;background:${p.c};transform:rotate(${p.r}deg)`}
            aria-hidden="true"
          />
        ))
      }

      <div class="relative flex h-full items-center justify-center gap-12 px-20">
        <Bouquet class="w-[330px] flex-none" />

        <div class="text-center">
          <p class="font-roman text-3xl tracking-[0.15em] text-rose-taupe italic" lang="en">
            The Wedding of
          </p>
          <p class="mt-1 font-script text-[7rem] leading-[1.1] whitespace-nowrap text-deep-red" lang="en">
            Yuma <span class="text-[4.5rem]">&amp;</span> Aimi
          </p>
          <p class="mt-3 text-3xl font-medium tracking-[0.2em] text-ink">
            佐竹 友真<span class="mx-3 text-deep-red">・</span>阿部 愛望
          </p>
          <div class="mx-auto mt-7 flex w-80 items-center gap-4 text-deep-red/60">
            <span class="h-px flex-1 bg-current"></span>
            <span class="h-2 w-2 rotate-45 bg-current"></span>
            <span class="h-px flex-1 bg-current"></span>
          </div>
          <p class="mt-5 font-roman text-5xl font-medium tracking-[0.12em] text-ink lining-nums">
            2026.11.07 <span class="text-3xl text-rose-taupe italic">Sat.</span>
          </p>
          <p class="mt-3 text-2xl tracking-[0.25em] text-ink">長良川清流ホテル</p>
        </div>
      </div>
    </div>
  </body>
</html>
