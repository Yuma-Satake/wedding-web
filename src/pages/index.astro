---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Countdown from "../components/Countdown.astro";
import Schedule from "../components/Schedule.astro";
import Venue from "../components/Venue.astro";
import Shuttle from "../components/Shuttle.astro";
import DressCode from "../components/DressCode.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import SideVisual from "../components/SideVisual.astro";
---

<Layout
	title="佐竹友真・阿部愛望 結婚式のご案内"
	description="2026年11月7日、長良川清流ホテルにて行われる結婚式のご案内です。"
>
	<SideVisual slot="aside" />
	<main>
		<Hero />
		<Countdown class="px-6 pb-14 lg:hidden" />
		<Schedule />
		<Venue />
		<Shuttle />
		<DressCode />
		<Contact />
	</main>
	<Footer />
</Layout>
